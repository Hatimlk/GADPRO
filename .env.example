NODE_ENV=production
PORT=4000
PUBLIC_URL=https://preprod.gadimat.pro
WEB_ORIGIN=https://preprod.gadimat.pro
CENTRAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gadimat_identity
CHEQUES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gadimat_cheques
IMPAYES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gadimat_impayes
LOGISTICS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gadimat_logistique
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_VALUE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
ERP_DB_HOST=READ_ONLY_HOST
ERP_DB_PORT=5432
ERP_DB_NAME=OPENPROD_DATABASE
ERP_DB_USER=READ_ONLY_USER
ERP_DB_PASSWORD=READ_ONLY_PASSWORD
SMTP_HOST=SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_USER
SMTP_PASS=SMTP_PASSWORD
SMTP_FROM_NAME=GADPRO
SMTP_FROM_EMAIL=no-reply@example.invalid
EMAIL_MODE=disabled
EMAIL_TEST_TO=
CRON_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
ERP_SYNC_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_VALUE
ERP_SYNC_TARGET_URL=http://127.0.0.1:4000/api/impayes/erp-sync
