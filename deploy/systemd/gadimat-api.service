[Unit]
Description=API GADIMAT
After=network.target postgresql.service

[Service]
Type=simple
User=gadimat
Group=gadimat
WorkingDirectory=/var/www/gadimat/current
EnvironmentFile=/etc/gadimat/gadimat.env
ExecStart=/usr/bin/node apps/api/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/gadimat

[Install]
WantedBy=multi-user.target
